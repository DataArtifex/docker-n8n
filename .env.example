# ==============================================================================
# Data Artifex n8n Stack Configuration
# ==============================================================================

# n8n Release Tag:
# Use 'next' or 'v3-nightly' for n8n v3 beta/testing
# Use 'latest' or a pinned tag (e.g. 2.45.1) for n8n v2 stable
N8N_VERSION=next

# General Settings
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC

# Critical Security Tokens (Generate unique secrets for production!)
# e.g.: openssl rand -hex 24
N8N_ENCRYPTION_KEY=replace_with_a_secure_random_encryption_key_32chars
N8N_RUNNERS_AUTH_TOKEN=replace_with_a_secure_runner_auth_token_32chars

# Task Runner Security and Allowlist Settings
N8N_RUNNERS_EXTERNAL_ALLOW=*
N8N_RUNNERS_STDLIB_ALLOW=*
NODE_FUNCTION_ALLOW_EXTERNAL=*
NODE_FUNCTION_ALLOW_BUILTIN=*

# PostgreSQL 18 Production Database Configuration (Used with docker-compose.prod.yml)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace_with_a_secure_postgres_password
POSTGRES_DB=n8n
POSTGRES_PORT=5432
